{
  "appId": "com.eraskon.inventory",
  "appName": "Eraskon Inventory",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "app.eraskon.com",
    "allowNavigation": ["api.eraskon.com"]
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1A56DB",
      "showSpinner": false
    }
  }
}
